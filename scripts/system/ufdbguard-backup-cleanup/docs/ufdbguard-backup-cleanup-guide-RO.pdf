stream
BT /F1 8 Tf 36 800 Td 10.5 TL
([[ -z "$MODE" || "$MODE" == '--dry-run' ]] || {) Tj
T* (  log "Argument invalid: $MODE"; exit 2;) Tj
T* (}) Tj
T* () Tj
T* (exec 9>"$LOCK") Tj
T* (flock -n 9 || { log 'Alta curatare ruleaza; iesire.'; exit 0; }) Tj
T* () Tj
T* ([[ -d "$BASE" && ! -L "$BASE" ]] || { log 'BASE invalid'; exit 1; }) Tj
T* ([[ -d "$ACTIVE" && ! -L "$ACTIVE" ]] || { log 'Lista activa lipseste'; exit 1; }) Tj
T* ([[ "$\(findmnt -n -o TARGET -T "$BASE"\)" == '/var' ]] || {) Tj
T* (  log 'Mount neasteptat pentru directorul de date'; exit 1;) Tj
T* (}) Tj
T* (for svc in squid ufdbguard; do) Tj
T* (  systemctl is-active --quiet "$svc" || {) Tj
T* (    log "Serviciu inactiv: $svc; nu sterg nimic"; exit 1;) Tj
T* (  }) Tj
T* (done) Tj
T* () Tj
T* (# Detectie suplimentara, nu substituie lock comun cu updater-ul.) Tj
T* (if pgrep -f '[/]etc/ufdbguard/scripts/20-fetch-ut1\\.sh' >/dev/null; then) Tj
T* (  log 'Updater detectat; curatare amanata.'; exit 0) Tj
T* (fi) Tj
T* () Tj
T* (mapfile -d '' BACKUPS < <\() Tj
T* (  find "$BASE" -mindepth 1 -maxdepth 1 -type d \\) Tj
T* (    -name 'blacklists.bak.*' -print0 | LC_ALL=C sort -z) Tj
T* (\)) Tj
T* (VALID=\(\)) Tj
T* (for dir in "${BACKUPS[@]}"; do) Tj
T* (  name="${dir##*/}") Tj
T* (  [[ "$name" =~ ^blacklists\\.bak\\.[0-9]{4}-[0-9]{2}-[0-9]{2}-[0-9]{6}$ ]] || continue) Tj
T* (  [[ ! -L "$dir" ]] || continue) Tj
T* (  VALID+=\("$dir"\)) Tj
T* (done) Tj
T* () Tj
T* (count=${#VALID[@]}) Tj
T* (log "Backupuri valide: $count; retentie: $KEEP; mod: ${MODE:-real}") Tj
T* (\(\( count > KEEP \)\) || { log 'Nimic de eliminat'; exit 0; }) Tj
T* () Tj
T* (df -h "$BASE") Tj
T* (delete_count=$\(\(count - KEEP\)\)) Tj
T* (log 'Backupuri protejate \(ultimele 3\):') Tj
T* (printf '  %s\\n' "${VALID[@]:delete_count}") Tj
T* () Tj
T* (for \(\( i=0; i<delete_count; i++ \)\); do) Tj
T* (  dir="${VALID[$i]}") Tj
T* (  [[ "$dir" == "$BASE"/blacklists.bak.* && -d "$dir" && ! -L "$dir" ]] || exit 1) Tj
T* (  # Protectie daca directorul a fost modificat in ultimele 3 ore.) Tj
T* (  if find "$dir" -maxdepth 0 -mmin -180 -print -quit | grep -q .; then) Tj
T* (    log "OMIS \(recent\): $dir"; continue) Tj
T* (  fi) Tj
T* (  if [[ "$MODE" == '--dry-run' ]]; then) Tj
T* (    log "SIMULARE: $dir") Tj
T* (  else) Tj
T* (    log "STERG: $dir") Tj
T* (    rm -rf --one-file-system -- "$dir") Tj
T* (  fi) Tj
T* (done) Tj
T* (log 'Verificare finala:') Tj
T* (df -h "$BASE") Tj
T* (systemctl is-active squid ufdbguard) Tj
T* () Tj
T* () Tj
T* (=== ufdbguard-backup-cleanup.service ===) Tj
T* ([Unit]) Tj
ET
endstream
