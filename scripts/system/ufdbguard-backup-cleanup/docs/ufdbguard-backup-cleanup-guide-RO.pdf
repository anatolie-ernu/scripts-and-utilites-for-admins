stream
BT /F1 8 Tf 36 800 Td 10.5 TL
(Description=ufdbGuard blacklist backup retention cleanup) Tj
T* (After=local-fs.target) Tj
T* () Tj
T* ([Service]) Tj
T* (Type=oneshot) Tj
T* (User=root) Tj
T* (ExecStart=/usr/local/sbin/ufdbguard-backup-cleanup.sh) Tj
T* (TimeoutStartSec=30min) Tj
T* (Nice=10) Tj
T* (IOSchedulingClass=idle) Tj
T* () Tj
T* () Tj
T* (=== ufdbguard-backup-cleanup.timer ===) Tj
T* ([Unit]) Tj
T* (Description=Daily ufdbGuard blacklist backup retention cleanup) Tj
T* () Tj
T* ([Timer]) Tj
T* (OnCalendar=*-*-* 04:30:00) Tj
T* (Persistent=true) Tj
T* (RandomizedDelaySec=0) Tj
T* (Unit=ufdbguard-backup-cleanup.service) Tj
T* () Tj
T* ([Install]) Tj
T* (WantedBy=timers.target) Tj
T* () Tj
ET
endstream
